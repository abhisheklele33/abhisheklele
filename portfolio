.btn-primary{background:var(--text);color:var(--bg);padding:0.55rem 1.3rem;border-radius:2px;font-size:13px;font-family:'DM Mono',monospace;letter-spacing:0.04em;transition:opacity 0.2s;cursor:pointer;display:inline-block}
.btn-primary:hover{opacity:0.78}
.btn-ghost{font-size:13px;font-family:'DM Mono',monospace;color:var(--muted);letter-spacing:0.04em;border-bottom:0.5px solid var(--border);padding-bottom:1px;transition:color 0.2s}
.btn-ghost:hover{color:var(--text)}

.divider{height:0.5px;background:var(--border);margin:0 3rem}
section{padding:3.5rem 3rem}
.section-label{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:0.12em;color:var(--muted);text-transform:uppercase;margin-bottom:2.5rem}

/* PROJECT LIST */
.projects-list{display:flex;flex-direction:column}
.project-row{display:grid;grid-template-columns:1fr auto;align-items:start;padding:1.4rem 0;border-top:0.5px solid var(--border);gap:2rem}
.project-row:last-child{border-bottom:0.5px solid var(--border)}
.project-row:hover .proj-title{color:var(--accent)}
.proj-link{display:contents}
.proj-meta{display:flex;gap:0.75rem;align-items:baseline;margin-bottom:0.45rem;flex-wrap:wrap}
.proj-num{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted)}
.proj-date{font-family:'DM Mono',monospace;font-size:10px;color:var(--muted)}
.proj-current{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.06em;padding:2px 7px;background:var(--green-bg);color:var(--green-text);border-radius:1px}
.proj-title{font-size:15px;font-weight:500;margin-bottom:0.35rem;transition:color 0.2s;line-height:1.3;cursor:pointer}
.proj-desc{font-size:13px;color:var(--muted);max-width:560px;line-height:1.65}
.proj-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:0.7rem}
.tag{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.05em;padding:3px 8px;background:var(--tag-bg);color:var(--tag-text);border-radius:1px}
.proj-arrow{font-size:16px;color:var(--border);padding-top:4px;transition:color 0.2s}
.project-row:hover .proj-arrow{color:var(--accent)}

/* SKILLS */
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1px;background:var(--border);border:0.5px solid var(--border)}
.skill-cell{background:var(--bg);padding:1.4rem;display:flex;flex-direction:column;gap:0.4rem}
.skill-cell-title{font-size:13px;font-weight:500}
.skill-cell-items{font-size:12px;font-family:'DM Mono',monospace;color:var(--muted);line-height:1.9}

/* EXPERIENCE */
.exp-list{display:flex;flex-direction:column}
.exp-row{padding:1.4rem 0;border-top:0.5px solid var(--border)}
.exp-row:last-child{border-bottom:0.5px solid var(--border)}
.exp-header{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:0.2rem;gap:1rem;flex-wrap:wrap}
.exp-title{font-size:14px;font-weight:500}
.exp-date{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted)}
.exp-org{font-size:13px;color:var(--muted);margin-bottom:0.6rem;display:flex;align-items:center;gap:0.5rem}
.incoming-badge{font-family:'DM Mono',monospace;font-size:10px;padding:2px 7px;background:var(--green-bg);color:var(--green-text);border-radius:1px}
.exp-desc{font-size:13px;color:var(--muted);line-height:1.65}

/* FOOTER */
footer{padding:2.2rem 3rem;border-top:0.5px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}
.footer-left{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted)}
.footer-links{display:flex;gap:1.5rem}
.footer-links a{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);transition:color 0.2s}
.footer-links a:hover{color:var(--text)}

/* PROJECT PAGE */
.proj-page-hero{padding:4rem 3rem 2.5rem;border-bottom:0.5px solid var(--border);max-width:900px}
.proj-page-label{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:0.1em;color:var(--muted);text-transform:uppercase;margin-bottom:1rem}
.proj-page-title{font-size:clamp(1.6rem,3.5vw,2.8rem);font-weight:300;line-height:1.15;letter-spacing:-0.02em;margin-bottom:1.2rem}
.proj-page-meta{display:flex;gap:1.5rem;flex-wrap:wrap;margin-bottom:1.2rem}
.proj-page-meta-item{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted)}
.proj-page-meta-item span{color:var(--text);font-weight:500}
.proj-page-tags{display:flex;flex-wrap:wrap;gap:6px}

.proj-content{max-width:800px;padding:3rem 3rem}
.proj-section{margin-bottom:3rem}
.proj-section-title{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:0.12em;color:var(--muted);text-transform:uppercase;margin-bottom:1.2rem;padding-bottom:0.6rem;border-bottom:0.5px solid var(--border)}
.proj-section p{font-size:14px;color:var(--text);line-height:1.8;margin-bottom:1rem}
.proj-section p:last-child{margin-bottom:0}

/* KEY SPECS */
.specs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1px;background:var(--border);border:0.5px solid var(--border);margin-bottom:2rem}
.spec-cell{background:var(--bg);padding:1.2rem}
.spec-label{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.08em;color:var(--muted);text-transform:uppercase;margin-bottom:0.3rem}
.spec-value{font-size:14px;font-weight:500;color:var(--text)}

/* FILES */
.files-list{display:flex;flex-direction:column;gap:0}
.file-row{display:flex;justify-content:space-between;align-items:center;padding:1rem 0;border-top:0.5px solid var(--border)}
.file-row:last-child{border-bottom:0.5px solid var(--border)}
.file-info{display:flex;align-items:center;gap:0.75rem}
.file-icon{font-family:'DM Mono',monospace;font-size:10px;padding:3px 7px;background:var(--tag-bg);color:var(--tag-text);border-radius:1px;letter-spacing:0.05em}
.file-name{font-size:13px;font-weight:500}
.file-desc{font-size:12px;color:var(--muted);margin-top:2px}
.file-dl{font-family:'DM Mono',monospace;font-size:11px;color:var(--accent);border:0.5px solid var(--accent);padding:4px 10px;border-radius:2px;transition:background 0.2s,color 0.2s;white-space:nowrap}
.file-dl:hover{background:var(--accent);color:#fff}

/* HIGHLIGHT BOXES */
.highlight-box{border-left:2px solid var(--accent);padding:1rem 1.2rem;background:var(--tag-bg);margin:1.2rem 0;border-radius:0 2px 2px 0}
.highlight-box p{font-size:13px;color:var(--tag-text);margin:0;line-height:1.6}

/* GALLERY placeholder */
.gallery-placeholder{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:var(--border);border:0.5px solid var(--border);margin-bottom:1rem}
.gallery-item{background:var(--bg);aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:11px;color:var(--muted)}

@media(max-width:640px){
  nav{padding:1rem 1.5rem}
  .hero,.proj-page-hero,.proj-content,section{padding-left:1.5rem;padding-right:1.5rem}
  .divider{margin:0 1.5rem}
  footer{padding:1.5rem}
}
